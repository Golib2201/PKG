# --- АЛГОРИТМЫ ОБРАБОТКИ С КОРРЕКТНЫМ ПРИВЕДЕНИЕМ ТИПОВ ---

def apply_linear_contrast(image):
    """Линейное контрастирование (растяжение гистограммы)"""
    # Работаем строго в градациях серого для МРТ
    img_gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if len(image.shape) == 3 else image
    
    f_min, f_max = float(np.min(img_gray)), float(np.max(img_gray))
    if f_max == f_min:
        return img_gray
        
    # Формула растяжения диапазона
    contrast_img = ((img_gray - f_min) / (f_max - f_min) * 255.0)
    return np.clip(contrast_img, 0, 255).astype(np.uint8)


def apply_histogram_equalization(image):
    """Эквализация гистограммы для улучшения видимости тканей на МРТ"""
    img_gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if len(image.shape) == 3 else image
    
    # Используем адаптивную эквализацию (CLAHE) — она идеальна для медицинских снимков,
    # так как не пересвечивает картинку, а выравнивает контраст локально.
    clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8,8))
    return clahe.apply(img_gray)


def get_hist_plot(image, title="Гистограмма"):
    """Построение гистограммы распределения интенсивностей"""
    fig, ax = plt.subplots(figsize=(5, 3))
    img_gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) if len(image.shape) == 3 else image
    
    hist = cv2.calcHist([img_gray], [0], None, [256], [0, 256])
    
    ax.bar(range(256), hist.ravel(), color='gray', alpha=0.8, width=1.0)
    ax.set_xlim([0, 255])
    ax.grid(True, linestyle='--', alpha=0.5)
    ax.set_title(title, fontsize=10)
    return fig

